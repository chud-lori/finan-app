# finan-backup settings. Install as /etc/finan-backup.env (root:root, mode 600).
# Every variable is optional; the values shown are the defaults.
# systemd EnvironmentFile syntax: KEY=value, no `export`, wrap a value in quotes if it holds spaces.

# Container that runs mongod.
MONGO_CONTAINER=finan-mongo

# Database to dump.
MONGO_DB=finan

# Connection string for mongodump once finan-mongo has auth. Leave empty to dump without auth.
# No database in the path (MONGO_DB picks it), percent-encode special characters in the password, e.g.
# mongodb://backup:<password>@localhost:27017/?authSource=admin&directConnection=true
MONGO_BACKUP_URI=

# Where dumps land on the host, and how many days of them to keep.
BACKUP_DIR=/var/backups/finan
BACKUP_RETENTION_DAYS=14

# rclone destination for an off-site copy, e.g. r2:finan-backups. Empty = local copies only.
BACKUP_RCLONE_REMOTE=

# Discord webhook URL that receives a message when a run fails. Empty = no alert.
BACKUP_DISCORD_WEBHOOK=
